{
  "name": "clientcrypt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:wasm": "wasm-pack build wasm-crypto --release --target web --out-dir ../public/pkg",
    "build:web": "next build",
    "build": "npm run build:wasm && npm run build:web",
    "preview": "serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t clientcrypt ."
  },
  "dependencies": {
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "serve": "^14.2.6",
    "typescript": "^5",
    "wasm-pack": "^0.15.0"
  }
}
