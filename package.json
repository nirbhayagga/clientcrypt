{
  "name": "clientcrypt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:wasm": "wasm-pack build wasm-crypto --release --target web --out-dir ../public/pkg",
    "build:web": "next build",
    "build": "npm run build:wasm && npm run build:web",
    "preview": "serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t clientcrypt .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lighthouse": "lhci autorun",
    "build:cloudflare": "sh scripts/cf-build.sh",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "serve": "^14.2.6",
    "typescript": "^5",
    "wasm-pack": "^0.15.0",
    "wrangler": "^4.127.1"
  },
  "homepage": "https://clientcrypt.nirbhay.dev",
  "license": "MIT"
}
